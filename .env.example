# ==============================================
# MessWise Full-Stack Environment Variables
# ==============================================

# Backend Configuration
ENVIRONMENT=production
PROJECT_NAME=MessWise
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=replace-with-a-random-32-character-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite default or PostgreSQL)
# PostgreSQL Example: postgresql+asyncpg://user:password@localhost:5432/messwise
DATABASE_URL=sqlite+aiosqlite:///./messwise.db
AUTO_SEED_DATA=true

# Allowed CORS Origins (Supports comma-separated list, JSON array, or wildcard *)
BACKEND_CORS_ORIGINS=["*"]

# Frontend Configuration
VITE_API_URL=https://messwise-api.onrender.com/api/v1
VITE_STUDENT_PORTAL_URL=https://messwise-student.vercel.app
VITE_ADMIN_PORTAL_URL=https://messwise-admin.vercel.app
VITE_NGO_PORTAL_URL=https://messwise-ngo.vercel.app
